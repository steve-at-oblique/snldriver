; ----------------------------------------------------------------------------
; Serial byte helpers
; ----------------------------------------------------------------------------

; All serial helpers preserve D2-D7/A0-A6. Return D0=status,
; D1=received byte/word/long. Big endian, independent of buffer alignment.

snl_send moveq    #io.sbyte,d0
         bra      snl_trap
snl_recv moveq    #io.fbyte,d0
         bsr      snl_trap
         bne      sr_ret
         addq.w   #1,snl_rx(a5)
sr_ret   tst.l    d0
         rts
snl_trap movem.l  d2-d7/a0-a3,-(a7)
         tst.b    snl_dead(a5)
         bne      st_dead
         move.l   d0,d4                     ; byte operation to retry on ERR.NC
         move.l   d1,d5                     ; original transmit byte
         moveq    #$13,d0                   ; MT.RCLCK, whole seconds
         trap     #1
         move.l   d1,d6
         move.l   #262143,d7                ; also bound retries if RTC is stopped

; Call the serial driver's byte entry as QDOS would, without nesting the
; TRAP #3 manager. The driver may destroy D4-D7/A3-A5; protect our polling
; state and CDB pointer. D7=0 is the initial byte-operation end offset.

st_again bsr      snl_kick                  ; drain/start queued output without scheduler
         movem.l  d4-d7/a4-a6,-(a7)
         move.l   snl_serp(a5),a0
         move.l   ch_drivr(a0),a4           ; serial driver's access-layer link
         lea      -$18(a4),a3               ; assumed driver definition base
         move.l   $04(a4),a4                ; I/O entry from linkage
         move.l   d4,d0                     ; IO.FBYTE or IO.SBYTE
         move.l   d5,d1
         moveq    #0,d2
         moveq    #0,d3                     ; initial entry, not scheduler re-entry
         moveq    #0,d7
         jsr      (a4)
         movem.l  (a7)+,d4-d7/a4-a6
         move.w   d0,snl_last(a5)
         tst.l    d0
         beq      st_done
         cmpi.l   #err.nc,d0
         bne      st_fail
         subq.l   #1,d7
         beq      st_dead
         moveq    #$13,d0
         trap     #1
         sub.l    d6,d1
         cmpi.l   #snl_time,d1
         bcs      st_again
         bra      st_dead
st_done  cmpi.l   #io.sbyte,d4
         bne      st_ret
         bsr      snl_kick                  ; start a newly queued byte immediately
         bra      st_ret
st_dead  moveq    #err.te,d0                ; never replay a partly sent packet
st_fail  st       snl_dead(a5)
st_ret   movem.l  (a7)+,d2-d7/a0-a3
         tst.l    d0
         rts

; ----------------------------------------------------------------------------
; ROM transmit-service wrapper
; ----------------------------------------------------------------------------

; Wrapper around the validated standard ROM serial scheduler callback.
; This calls the ROM routine directly, not the general scheduler. It pushes its own SR and returns via RTE to the JSR return.
; D3=1 advances the ROM's port-switch countdown when the selected port is
; idle. It checks UART busy and CTS before sending, preserving hardware
; arbitration. All registers used by the file/byte routines are protected.

snl_kick movem.l  d0-d7/a0-a6,-(a7)
         move.l   snl_txp(a5),a0
         moveq    #1,d3
         jsr      (a0)
         movem.l  (a7)+,d0-d7/a0-a6
         rts

; ----------------------------------------------------------------------------
; Protocol status and integer helpers
; ----------------------------------------------------------------------------

snl_stat bsr      snl_recv
         bne      ss_ret
         move.b   d1,d0
         ext.w    d0
         ext.l    d0
         beq      ss_ret
         cmpi.l   #err.nc,d0
         bge      snl_bad
         cmpi.l   #err.ro,d0
         blt      snl_bad
         cmpi.l   #err.ni,d0
         bne      ss_ret
         bsr      dbg_host                  ; distinguish host rejection from local I/O
ss_ret   tst.l    d0
         rts
snl_bad  st       snl_dead(a5)
         moveq    #err.te,d0
         rts
snl_putl movem.l  d2-d3,-(a7)
         move.l   d1,d2
         moveq    #3,d3
         bra      sp_loop
snl_putw movem.l  d2-d3,-(a7)
         move.l   d1,d2
         swap     d2
         moveq    #1,d3
sp_loop  rol.l    #8,d2
         move.l   d2,d1
         bsr      snl_send
         bne      sp_ret
         dbra     d3,sp_loop
sp_ret   movem.l  (a7)+,d2-d3
         tst.l    d0
         rts
snl_getl movem.l  d2-d3,-(a7)
         moveq    #3,d3
         bra      sg_start
snl_getw movem.l  d2-d3,-(a7)
         moveq    #1,d3
sg_start moveq    #0,d2
sg_loop  bsr      snl_recv
         bne      sg_ret
         lsl.l    #8,d2
         move.b   d1,d2
         dbra     d3,sg_loop
         move.l   d2,d1
sg_ret   movem.l  (a7)+,d2-d3
         tst.l    d0
         rts
snl_ni   moveq    #err.ni,d0
         rts
snl_ser  dc.w     5
         dc.b     'SER2H',0

