         lea      dbg_stxt,a2
         bra      dbg_msg
dbg_fail movem.l  d0-d7/a0-a6,-(a7)
         move.l   d0,d4
         lea      dbg_ftxt,a2
         bra      dbg_msg
dbg_call movem.l  d0-d7/a0-a6,-(a7)
         moveq    #0,d4
         move.b   snl_call(a5),d4
         lea      dbg_ctxt,a2
         bra      dbg_msg
dbg_phas movem.l  d0-d7/a0-a6,-(a7)
         moveq    #0,d4
         move.b   snl_phas(a5),d4
         lea      dbg_ptxt,a2
         bra      dbg_msg
dbg_hi   movem.l  d0-d7/a0-a6,-(a7)
         moveq    #0,d4
         move.w   snl_cnt(a5),d4
         lsr.w    #8,d4
         lea      dbg_ktxt,a2
         bra      dbg_msg
dbg_cnt  movem.l  d0-d7/a0-a6,-(a7)
         moveq    #0,d4
         move.w   snl_cnt(a5),d4
         lea      dbg_ntxt,a2
         bra      dbg_msg
dbg_rom  movem.l  d0-d7/a0-a6,-(a7)
         move.l   d0,d4
         lea      dbg_ttxt,a2
         bra      dbg_msg
dbg_boot movem.l  d0-d7/a0-a6,-(a7)
         move.l   d0,d4
         lea      dbg_btxt,a2
dbg_msg  suba.w   #40,a7
         move.l   a7,a1
         moveq    #0,d3
         move.w   (a2),d3
         addq.w   #1,d3                     ; copy length word and payload, DBRA count
dbg_copy move.b   (a2)+,(a1)+
         dbra     d3,dbg_copy
         lea      dbg_hex,a0
         move.l   d4,d1
         lsr.b    #4,d1
         andi.w   #15,d1
         move.b   0(a0,d1.w),-3(a1)
         move.l   d4,d1
         andi.w   #15,d1
         move.b   0(a0,d1.w),-2(a1)
         move.l   a7,a1
         suba.l   a0,a0
         move.w   $D0,a2
         jsr      (a2)
         adda.w   #40,a7
         movem.l  (a7)+,d0-d7/a0-a6
