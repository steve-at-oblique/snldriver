; Channel definition block / driver headers
     
; Channel definition header for all channels

;        offset   0
ch_len    equ    $00         ;length of definition block
ch_drivr  equ    $04         ;address of driver
ch_owner  equ    $08         ;owner job
ch_rflag  equ    $0C         ;address to be set when space released
ch_tag    equ    $10         ;channel tag
ch_stat   equ    $12         ;status: 0 ok, else waiting -1 a1 abs, $80 a1 rel a6
ch_actn   equ    $13         ;stored action for waiting job
ch_jobwt  equ    $14         ;ID of job waiting on I/O
ch_end    equ    $18

; Extended channel definition for plain serial queues

ch_qin    equ    $18         ;pointer to input queue (or zero)
ch_qout   equ    $1C         ;pointer to output queue (or zero)
ch_qend   equ    $20


; Device driver  header, Linkage block

;        offset   0
ch_next   equ    $18-$18     ;pointer to next driver
ch_inout  equ    $1C-$18     ;entry for input and output
ch_open   equ    $20-$18     ;entry for open
ch_close  equ    $24-$18     ;entry for close
; the following  are for directory devices (file system) only:
ch_slave  equ    $28-$18     ;entry for slaving blocks
ch_renam  equ    $2C-$18     ;entry reserved for rename
;         equ    $30-$18
ch_formt  equ    $34-$18     ;entry for format medium
ch_dflen  equ    $38-$18     ;length of physical definition block
ch_drnam  equ    $3C-$18     ;length prefixed drive name
; Extended linkage block for MDI driver
ch_aname  equ    $42-$18     ;length prefixed actual drive name


; MDI driver storage & work area
devtable  equ    $48            ;start of device table. Word Write/Protect status

wpflags   equ    devtable       ; w Write/Protect status
chtable   equ    devtable+$02   ; l*8 channel ID's
cartname  equ    devtable+$22   ;storage for medium name and random number. 8 x 12 byte entrys

ch_lkend  equ    devtable+$82   ;end of linkage block
  

; File system definitions

fs.nmlen  equ     36         ;max length of file name
fs.hdlen  equ     64         ;length of file system header

; File system channel channel definition block

;        offset   $18 ( = ch_end, end of standard channel header )
fs_next     equ    $18       ;link to next file system channel
fs_acces    equ    $1C       ;access mode
fs_drive    equ    $1D       ;drive id
fs_filnr    equ    $1E       ;file number
fs_nblok    equ    $20       ;block containing next byte
fs_nbyte    equ    $22       ;next byte in block
fs_eblok    equ    $24       ;end of file (block)
fs_ebyte    equ    $26       ;end of file (byte in block)
fs_cblok    equ    $28       ;pointer to table for current slave block
fs_updt     equ    $2C       ;set if file is updated
fs_usef     equ    $2D       ;parts of file header not to update on close
fs..bst       equ    0       ;backup date set
fs..vst       equ    1       ;version set
fs..ust       equ    2       ;update date set

;           equ    $2E       ;spare
fs_fname    equ    $32       ;length prefixed file name
fs_spare    equ    $58       ;72 bytes spare          
fs_end      equ    $A0


; Common part of a physical file system definition block

;        offset   0
fs_drivr   equ     $10       ;pointer to driver
fs_drivn   equ     $14       ;drive number
fs_resve   equ     $15       ;reserved
fs_mname   equ     $16       ;ds.w   1+10/2  length prefixed medium name
fs_files   equ     $22       ;ds.b   1       number of files open

  
; basic I/O keys

; Trap #2 d0 codes

io.open   equ     $01        ;open channel
io.close  equ     $02        ;close channel
io.formt  equ     $03        ;format medium
io.delet  equ     $04        ;delete file

; Trap #2 d3 codes

io.old    equ     $00        ;open old (exclusive) file or device
io.share  equ     $01        ;open shared (old) file
io.new    equ     $02        ;open new (exclusive) file
io.overw  equ     $03        ;open overwrite (or open new) file
io.dir    equ     $04        ;open directory

; Trap #3 d0 codes

io.pend   equ     $00        ;check for pending input
io.fbyte  equ     $01        ;fetch a byte
io.fline  equ     $02        ;fetch a line of bytes
io.fstrg  equ     $03        ;fetch a string of bytes
io.edlin  equ     $04        ;edit a line
io.sbyte  equ     $05        ;send a byte

io.sstrg  equ     $07        ;send a string of bytes


; File system trap #3 codes

fs.check  equ     $40        ;check all pending operations
fs.flush  equ     $41        ;flush buffers
fs.posab  equ     $42        ;position file pointer (absolute)
fs.posre  equ     $43        ;position file pointer (relative)

fs.mdinf  equ     $45        ;information about medium
fs.heads  equ     $46        ;set file header
fs.headr  equ     $47        ;read file header
fs.load   equ     $48        ;load file
fs.save   equ     $49        ;save file
fs.renam  equ     $4A        ;rename file
fs.trunc  equ     $4B        ;truncate file

fs.date   equ     $4C        ;set or read file date
fs.makdr  equ     $4D        ;make directory   -   not implemented
fs.vers   equ     $4E        ;set or read file version
fs.xinf   equ     $4F        ;get extended information


